{
  "description": "Recurring assessment, research, and active-objective guidance; resource collection is opt-in and registered separately",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/behavior.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/behavior.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
