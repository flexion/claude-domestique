.strictEqual(slugify('  The Quick -- Brown Fox!  '), 'the-quick-brown-fox');\n});\n\ntest('slugify returns empty string when nothing survives', () => {\n  assert.strictEqual(slugify(''), '');\n  assert.strictEqual(slugify('   '), '');\n  assert.strictEqual(slugify('!!!'), '');\n});\n","structuredPatch":[{"oldStart":36,"oldLines":6,"newStart":36,"newLines":11,"lines":["   assert.strictEqual(slugify('  The Quick -- Brown Fox!  '), 'the-quick-brown-fox');"," });"," ","+test('slugify folds accented latin letters to ascii', () => {","+  assert.strictEqual(slugify('Café'), 'cafe');","+  assert.strictEqual(slugify('Résumé Draft'), 'resume-draft');","+});","+"," test('slugify returns empty string when nothing survives', () => {","   assert.strictEqual(slugify(''), '');","   assert.strictEqual(slugify('   '), '');"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01FA8inzhBcg1hammD4Vvaro","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
